# Optional: copy to .env to override compose.yaml's local defaults.
# These variables configure Compose; application settings are documented in the run guides.
# For another clone running alongside this one, change the project AND ports.
COMPOSE_PROJECT_NAME=n2f-nest
N2F_POSTGRES_PORT=7220
N2F_POSTGRES_DB=n2f
N2F_POSTGRES_USER=n2f
N2F_POSTGRES_PASSWORD=n2f_local
N2F_REDIS_PORT=7221
N2F_NATS_PORT=7222
N2F_NATS_MONITOR_PORT=7223

# Local mail capture
N2F_SMTP_PORT=7225
N2F_MAILPIT_UI_PORT=7226

# Local S3 service; credentials initialize SeaweedFS's local identity.
N2F_S3_PORT=7230
N2F_S3_ACCESS_KEY=n2f_access
N2F_S3_SECRET_KEY=n2f_secret_local
N2F_S3_BUCKET=n2f-local

# Telemetry backend; application exporters use the TELEMETRY_HTTP.md settings.
N2F_GRAFANA_PORT=7240
N2F_GRAFANA_USER=n2f
N2F_GRAFANA_PASSWORD=n2f_local
N2F_OTLP_GRPC_PORT=7241
N2F_OTLP_HTTP_PORT=7242
